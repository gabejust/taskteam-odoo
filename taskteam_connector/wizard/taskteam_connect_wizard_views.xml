<odoo>

    <record id="taskteam_connect_wizard_view_form" model="ir.ui.view">
        <field name="name">taskteam.connect.wizard.form</field>
        <field name="model">taskteam.connect.wizard</field>
        <field name="arch" type="xml">
            <form string="Connect TaskTeam">
                <field name="connected" invisible="1"/>
                <field name="sales_available" invisible="1"/>
                <field name="time_off_available" invisible="1"/>
                <field name="attendance_available" invisible="1"/>
                <field name="rights_missing" invisible="1"/>
                <div class="alert alert-success" role="status" invisible="not connected">
                    TaskTeam is connected through the user <strong>TaskTeam</strong>
                    (login <code>taskteam</code>). You can create a new key (existing keys
                    keep working until you revoke them) or disconnect TaskTeam.
                </div>
                <div class="alert alert-warning" role="alert" invisible="not rights_missing">
                    An app was installed after TaskTeam was connected. Click
                    <em>Update permissions</em> so TaskTeam can sync it too. The key does not change.
                </div>
                <p>
                    <strong>TaskTeam is an external service</strong> (a task and chat app for
                    teams) run by Task Team Tech, S.L. It needs a TaskTeam account.
                    This assistant creates, in this database, a dedicated internal user
                    <code>taskteam</code> and an API key for it. With that user's rights only,
                    TaskTeam <strong>reads and writes</strong> the data your office chooses to
                    sync, so Odoo and TaskTeam stay the same:
                </p>
                <ul>
                    <li><strong>Employees and job positions</strong>: name, company, job position,
                        work phone and mobile, work email. The identification number is only
                        read, to recognise each person.</li>
                    <li><strong>Contacts</strong>: customers and suppliers.</li>
                    <li invisible="not time_off_available"><strong>Time off</strong>: requests,
                        their approval or refusal, and time off types.</li>
                    <li invisible="not attendance_available"><strong>Attendances</strong>:
                        check-in and check-out times.</li>
                    <li invisible="not sales_available"><strong>Draft sale orders</strong> (only if
                        you allow it): TaskTeam creates them with the signed delivery note PDF
                        attached, for your office to review and invoice. It never confirms them.</li>
                    <li><strong>Companies</strong> (the ones selected below) and <strong>the key
                        itself</strong> (its expiry date, to remind you to renew it): only read.</li>
                </ul>
                <p>
                    TaskTeam never deletes anything in Odoo: what is removed in TaskTeam is
                    archived or cancelled here. This module sends nothing anywhere by itself.
                    TaskTeam only gets access when you paste the key into TaskTeam, and loses it
                    when you click <em>Disconnect</em> or revoke the key.
                </p>
                <group>
                    <field name="company_ids" widget="many2many_tags"
                           options="{'no_create': True}" groups="base.group_multi_company"/>
                    <field name="odoo_url" readonly="1"/>
                </group>
                <div class="d-flex align-items-start gap-2 mb-3" invisible="not sales_available">
                    <field name="allow_sale_orders" nolabel="1"/>
                    <label for="allow_sale_orders"/>
                </div>
                <div class="d-flex align-items-start gap-2 mb-3">
                    <field name="consent" nolabel="1"/>
                    <label for="consent" class="fw-bold"
                           string="I understand that TaskTeam is an external service and I allow it to read and write the data listed above"/>
                </div>
                <div invisible="not api_key_ids">
                    <h5>Keys of the TaskTeam user</h5>
                    <field name="api_key_ids" readonly="1" nolabel="1">
                        <list create="0" delete="0" edit="0">
                            <field name="name"/>
                            <field name="create_date"/>
                            <field name="expiration_date"/>
                        </list>
                    </field>
                </div>
                <footer>
                    <button name="action_connect" type="object" string="Connect TaskTeam"
                            class="btn-primary" invisible="connected" data-hotkey="q"/>
                    <button name="action_connect" type="object" string="Create a new key"
                            class="btn-primary" invisible="not connected" data-hotkey="w"/>
                    <button name="action_update_rights" type="object" string="Update permissions"
                            class="btn-primary" invisible="not rights_missing"/>
                    <button name="action_disconnect" type="object" string="Disconnect"
                            class="btn-secondary" invisible="not connected"
                            confirm="Disconnect TaskTeam? All keys of the TaskTeam user will be revoked and the user will be archived. TaskTeam will stop syncing with this Odoo."/>
                    <button special="cancel" string="Close" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="taskteam_connect_key_view_form" model="ir.ui.view">
        <field name="name">taskteam.connect.key.form</field>
        <field name="model">taskteam.connect.key</field>
        <field name="arch" type="xml">
            <form string="Your TaskTeam key">
                <p>
                    Paste this key and your Odoo address (shown) in
                    <strong>TaskTeam › Settings › Connections › Odoo</strong>.
                </p>
                <group>
                    <field name="key" widget="CopyClipboardChar"/>
                    <field name="odoo_url" widget="CopyClipboardChar"/>
                    <field name="expiration_date"/>
                </group>
                <p class="text-muted">
                    If TaskTeam asks for them: database <field name="database" class="d-inline"/>,
                    user <field name="login" class="d-inline"/>.
                </p>
                <div class="alert alert-warning" role="alert">
                    <strong>This key is shown only once.</strong> Odoo keeps only a fingerprint
                    of it, so it cannot be displayed again. If you lose it, open
                    Settings › TaskTeam and create a new key.
                </div>
                <footer>
                    <button special="cancel" string="Done" class="btn-primary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_taskteam_connect_wizard" model="ir.actions.act_window">
        <field name="name">Connect TaskTeam</field>
        <field name="res_model">taskteam.connect.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="group_ids" eval="[Command.link(ref('base.group_system'))]"/>
    </record>

    <menuitem id="menu_taskteam_connect"
              name="TaskTeam"
              parent="base.menu_administration"
              action="action_taskteam_connect_wizard"
              groups="base.group_system"
              sequence="90"/>

</odoo>
