#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"Disconnect TaskTeam? All keys of the TaskTeam user will be revoked and the "
"user will be archived. TaskTeam will stop reading data from this Odoo."
msgstr "¿Desconectar TaskTeam? Se revocarán todas las claves del usuario de TaskTeam y el usuario se archivará. TaskTeam dejará de leer datos de este Odoo."

#. module: taskteam_connector
#: model:ir.model.fields,field_description:taskteam_connector.field_taskteam_connect_key__display_name
#: model:ir.model.fields,field_description:taskteam_connector.field_taskteam_connect_wizard__display_name
