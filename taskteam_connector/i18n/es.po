#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_key_view_form
msgid ""
",\n"
"                    user"
msgstr ", usuario"

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid "<strong>Companies</strong>: the companies selected below."
msgstr "<strong>Empresas</strong>: las empresas que elijas abajo."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"<strong>Customers and suppliers</strong>: contacts marked as customer or\n"
"                        supplier."
msgstr "<strong>Clientes y proveedores</strong>: los contactos marcados como cliente o proveedor."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"<strong>Employees</strong>: name, company, job position, work phone and\n"
"                        mobile, work email and, when the TaskTeam user may read it in Odoo,\n"
"                        the identification number."
msgstr "<strong>Empleados</strong>: nombre, empresa, puesto de trabajo, teléfono y móvil del trabajo, correo del trabajo y, cuando el usuario de TaskTeam puede verlo en Odoo, el número de identificación."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"<strong>TaskTeam is an external service</strong> (a task and chat app for\n"
"                    field teams) run by Task Team Tech, S.L. It needs a TaskTeam account.\n"
"                    This assistant creates, in this database, a dedicated internal user\n"
"                    <code>taskteam</code> with minimal rights and an API key for it. TaskTeam\n"
"                    then reads, through Odoo's external API, only what that user can read:"
msgstr "<strong>TaskTeam es un servicio externo</strong> (una app de tareas y chat para equipos que trabajan fuera de la oficina) de Task Team Tech, S.L. Necesitas una cuenta de TaskTeam. Este asistente crea, en esta base de datos, un usuario interno propio, <code>taskteam</code>, con los permisos mínimos y una clave de API para él. Después TaskTeam lee, a través de la API externa de Odoo, solo lo que ese usuario puede leer:"

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"<strong>The key itself</strong>: its expiry date, to remind you to renew it."
msgstr "<strong>La propia clave</strong>: su fecha de caducidad, para recordarte que la renueves."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_key_view_form
msgid ""
"<strong>This key is shown only once.</strong> Odoo keeps only a fingerprint\n"
"                    of it, so it cannot be displayed again. If you lose it, open\n"
"                    Settings › TaskTeam and create a new key."
msgstr "<strong>Esta clave solo se muestra una vez.</strong> Odoo guarda solo una huella de ella, así que no se puede volver a ver. Si la pierdes, abre Ajustes › TaskTeam y crea una clave nueva."

#. module: taskteam_connector
#: model:ir.model.fields,field_description:taskteam_connector.field_taskteam_connect_key__key
msgid "API key"
msgstr "Clave de API"

