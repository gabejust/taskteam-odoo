#. module: taskteam_connector
#. odoo-python
#: code:addons/taskteam_connector/wizard/taskteam_connect_wizard.py:0
msgid "Only administrators can connect TaskTeam."
msgstr "Solo los administradores pueden conectar TaskTeam."

#. module: taskteam_connector
#. odoo-python
#: code:addons/taskteam_connector/wizard/taskteam_connect_wizard.py:0
msgid "Only administrators can disconnect TaskTeam."
msgstr "Solo los administradores pueden desconectar TaskTeam."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_key_view_form
msgid ""
"Paste this key and your Odoo address (shown) in\n"
"                    <strong>TaskTeam › Perfil › Conexiones › Odoo</strong>."
msgstr "Pega esta clave y la dirección de tu Odoo (la tienes aquí) en <strong>TaskTeam › Perfil › Conexiones › Odoo</strong>."

#. module: taskteam_connector
#. odoo-python
#: code:addons/taskteam_connector/wizard/taskteam_connect_wizard.py:0
msgid ""
"Please tick the consent box first: TaskTeam is an external service and will "
"read the data listed on this screen."
msgstr "Primero marca la casilla de consentimiento: TaskTeam es un servicio externo y leerá los datos de la lista de esta pantalla."

#. module: taskteam_connector
#. odoo-python
#: code:addons/taskteam_connector/wizard/taskteam_connect_wizard.py:0
msgid "Select at least one company."
msgstr "Elige al menos una empresa."

#. module: taskteam_connector
#: model:ir.ui.menu,name:taskteam_connector.menu_taskteam_connect
msgid "TaskTeam"
msgstr "TaskTeam"

#. module: taskteam_connector
#: model:ir.model.fields,help:taskteam_connector.field_taskteam_connect_wizard__consent
msgid ""
"TaskTeam is an external service. Tick this box to allow it to read the data "
"listed above with the key created here."
msgstr "TaskTeam es un servicio externo. Marca esta casilla para permitirle leer los datos de la lista de arriba con la clave que se crea aquí."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"TaskTeam is connected through the user <strong>TaskTeam</strong>\n"
"                    (login <code>taskteam</code>). You can create a new key (existing keys\n"
"                    keep working until you revoke them) or disconnect TaskTeam."
msgstr "TaskTeam está conectado con el usuario <strong>TaskTeam</strong> (usuario <code>taskteam</code>). Puedes crear una clave nueva (las que ya existen siguen funcionando hasta que las revoques) o desconectar TaskTeam."

#. module: taskteam_connector
#. odoo-python
#: code:addons/taskteam_connector/wizard/taskteam_connect_wizard.py:0
msgid ""
"TaskTeam is disconnected: its keys are revoked and its user is archived."
msgstr "TaskTeam está desconectado: sus claves están revocadas y su usuario, archivado."

#. module: taskteam_connector
#: model:ir.model,name:taskteam_connector.model_taskteam_connect_key
msgid "TaskTeam key (shown once)"
msgstr "Clave de TaskTeam (se muestra una vez)"

#. module: taskteam_connector
#: model:ir.model.fields,field_description:taskteam_connector.field_taskteam_connect_wizard__taskteam_user_id
msgid "TaskTeam user"
msgstr "Usuario de TaskTeam"

#. module: taskteam_connector
#: model:ir.model.fields,help:taskteam_connector.field_taskteam_connect_wizard__company_ids
msgid "TaskTeam will only read data from these companies."
msgstr "TaskTeam solo leerá datos de estas empresas."

#. module: taskteam_connector
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_wizard_view_form
msgid ""
"This module sends nothing anywhere by itself. TaskTeam only gets access\n"
"                    when you paste the key into TaskTeam, and loses it when you click\n"
"                    <em>Disconnect</em> or revoke the key."
msgstr "Este módulo no envía nada a ningún sitio por su cuenta. TaskTeam solo tiene acceso cuando pegas la clave en TaskTeam, y lo pierde cuando pulsas <em>Desconectar</em> o revocas la clave."

#. module: taskteam_connector
#: model:ir.model.fields,field_description:taskteam_connector.field_taskteam_connect_key__expiration_date
msgid "Valid until"
msgstr "Válida hasta"

#. module: taskteam_connector
#. odoo-python
#: code:addons/taskteam_connector/wizard/taskteam_connect_wizard.py:0
#: model_terms:ir.ui.view,arch_db:taskteam_connector.taskteam_connect_key_view_form
